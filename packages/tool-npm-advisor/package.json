{
  "name": "@cqpdrcuk/dsh-plugin-npm-advisor",
  "version": "0.1.1",
  "description": "DSH 插件：npm 包引入前审查（原生替代 / 维护健康度 / README 迁移线索 / 依赖树可视化）",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "npm",
    "dependency"
  ],
  "license": "MIT"
}
